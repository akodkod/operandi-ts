{
  "name": "operandi",
  "version": "1.0.0",
  "description": "Type-safe, schema-validated business logic in sequential steps",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "default": "./dist/vite.mjs"
    },
    "./eslint": {
      "types": "./dist/eslint.d.mts",
      "default": "./dist/eslint.mjs"
    },
    "./oxlint": {
      "types": "./dist/oxlint.d.mts",
      "default": "./dist/oxlint.mjs"
    }
  },
  "scripts": {
    "build": "vp pack",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "lint": "vp lint",
    "prepublishOnly": "bun check && bun test && bun run lint && bun run build",
    "check:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "@babel/parser": "^7.29.14",
    "@babel/traverse": "^7.29.14",
    "@oxlint/plugins": "^1.94.0",
    "@standard-schema/spec": "^1.1.0",
    "magic-string": "^1.4.5"
  },
  "devDependencies": {
    "@babel/types": "^7.29.14",
    "@stylistic/eslint-plugin": "6.0.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/bun": "^1.4.4",
    "arktype": "^2.2.10",
    "eslint": "^10.15.0",
    "eslint-plugin-import-newlines": "2.0.0",
    "eslint-plugin-sane": "2.4.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unicorn": "79.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0",
    "vite-plus": "^1.7.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0",
    "vite": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "eslint": {
      "optional": true
    }
  },
  "packageManager": "bun@1.4.4"
}
